{
  "name": "@mohandesyar/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts serve",
    "migrate": "tsx src/main.ts migrate",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@mohandesyar/module-package": "workspace:*",
    "@mohandesyar/module-sdk": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "6.3.15",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "^7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mohandesyar/module-cli": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0"
  }
}

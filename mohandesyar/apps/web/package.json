{
  "name": "@mohandesyar/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "node scripts/build-shared.mjs",
    "build": "node scripts/build-shared.mjs && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "dev": "node scripts/build-shared.mjs && vite build --watch --mode development",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@mohandesyar/module-sdk": "workspace:*",
    "@mohandesyar/persian": "workspace:*",
    "@mohandesyar/ui": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.57.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

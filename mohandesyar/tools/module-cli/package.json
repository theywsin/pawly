{
  "name": "@mohandesyar/module-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mohandesyar-module": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mohandesyar/module-package": "workspace:*",
    "@mohandesyar/module-sdk": "workspace:*",
    "@mohandesyar/ui": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}

{
  "name": "@mohandesyar/module-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@tanstack/react-query": "5.104.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/semver": "^7.8.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "react": "^19.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  }
}

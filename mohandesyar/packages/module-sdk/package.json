{
  "name": "@mohandesyar/module-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@types/semver": "^7.8.0",
    "drizzle-orm": "0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "drizzle-orm": "^0.45.0"
  }
}

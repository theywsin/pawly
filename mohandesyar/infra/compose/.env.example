# --- secrets: generate fresh values (e.g. `openssl rand -hex 32`) -----------------------------
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_KEY=          # 64 hex chars (32 bytes)
# --- object storage (S3-compatible) -----------------------------------------------------------
# Any S3-compatible object storage: the organisation's own S3 service, MinIO, Garage, SeaweedFS, or a provider's S3 API.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=mohandesyar
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- modules -------------------------------------------------------------------------------
MODULE_TRUSTED_KEYS=/keys/release.pub.pem   # comma-separated public keys trusted at migrate time
# PREINSTALLED_MODULES_DIR=/app/preinstalled
# --- http -----------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_WORKERS=2
COOKIE_SECURE=true                           # serve behind TLS (reverse proxy)
HTTP_BIND=127.0.0.1:3000
PUBLIC_ORIGIN=https://example.ir          # canonical URLs, sitemap.xml, robots.txt, links in emails
# Email copies of notifications (empty = in-app only). Use smtps://…:465 for implicit TLS; STARTTLS is used on 587 when offered.
SMTP_URL=
MAIL_FROM="مهندیکس <no-reply@example.ir>"
TRUST_PROXY=loopback,uniquelocal          # peers allowed to set X-Forwarded-For (the reverse proxy)

# Generated by install.sh on first run; edit and restart (docker compose up -d) to change.
# --- address ---------------------------------------------------------------------------------
SITE_ADDRESS=example.ir                  # domain for automatic HTTPS, or :80 for plain HTTP
PUBLIC_ORIGIN=https://example.ir         # exact address users open; also signs download links
HTTP_PORT=80                             # host ports the proxy listens on
HTTPS_PORT=443
COOKIE_SECURE=true                       # false only when serving plain HTTP
# --- secrets (openssl rand -hex 32) ----------------------------------------------------------
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_KEY=                      # 64 hex chars; keep it with your backups — encrypted secrets need it
# --- object storage (built-in SeaweedFS; s3.json holds the same key pair) ----------------------
S3_REGION=us-east-1
S3_BUCKET=mohandesyar
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- runtime ---------------------------------------------------------------------------------
API_WORKERS=2
TRUST_PROXY=loopback,uniquelocal
# Email copies of notifications (empty = in-app only), e.g. smtps://user:pass@mail.example.ir:465
SMTP_URL=
MAIL_FROM="مهندیکس <no-reply@example.ir>"

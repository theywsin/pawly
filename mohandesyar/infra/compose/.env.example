# --- secrets: generate fresh values (e.g. `openssl rand -hex 32`) -----------------------------
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_KEY=          # 64 hex chars (32 bytes)
# --- object storage (S3-compatible) -----------------------------------------------------------
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=mohandesyar
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- modules -------------------------------------------------------------------------------
MODULE_TRUSTED_KEYS=/keys/release.pub.pem   # comma-separated public keys trusted at migrate time
# PREINSTALLED_MODULES_DIR=/app/preinstalled
# --- http -----------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_WORKERS=2
COOKIE_SECURE=true                           # serve behind TLS (reverse proxy)
HTTP_BIND=127.0.0.1:3000
